{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-llm-lab.invalid/stage2/task.schema.json",
  "title": "Stage 2 local coding-agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "objective",
    "acceptance_criteria",
    "workspace",
    "rules",
    "allowed_paths",
    "read_only_paths",
    "required_tests"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "mode": {
      "enum": ["autonomous", "plan", "delegated"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "workspace": {"type": "string", "minLength": 1},
    "fixture": {"type": ["string", "null"]},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "read_only_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "context_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
    "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 100, "default": 5},
    "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 300},
    "allow_new_files": {"type": "boolean", "default": false},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean", "default": true},
        "reviewer": {"type": "string", "minLength": 1, "default": "human"}
      }
    }
  }
}
